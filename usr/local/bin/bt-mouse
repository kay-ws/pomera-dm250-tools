#!/bin/bash
# 2026-09-19: run the UART at 1.5Mbps (--baudrate 1500000). At the default 115200bps, transmit tops out around 92kbps,
#   and A2DP audio drops out and is full of noise. 3Mbps does not work because the chip cannot match the rate (1.5Mbps seems to be this unit's limit).
# bt-mouse -- wake the BT chip and connect to a bonded LE mouse.
#
# Why a script is needed (details: https://zenn.dev/kay1974/articles/aa3143bed8f17d):
#  1. /opt/bin/bt_switch on starts patchram 3 seconds after lifting rfkill, but that first patchram
#     never gets a byte out. CTS does not rise by itself after power-on: it rises 4-10 ms after the host
#     raises RTS by opening /dev/ttyS0, and it stays high after the port is closed (measured 2026-10-02).
#     patchram turns on CRTSCTS right after that first open, while CTS is still low, so serial_core stops
#     TX (tty->hw_stopped). rk_serial never reports the later rise (its CTS handling is under #if 0 in the
#     public Rockchip release-3.10 source), so TX stays stopped: the tx counter of ttyS0 in
#     /proc/tty/driver/rk_serial does not advance. Moreover, bt_switch does not report the failure and
#     prints "bluetooth switch ON". Waiting does not help (measured 2026-10-01: sleep 3/10, 110 s, 0/6;
#     2026-10-02: sleep 0.2 in place of the open, 0/6).
#     -> open the port once ourselves during bt_switch's 3 s wait, so CTS is already high when patchram
#        opens it (hci0 in ~9 s). If hci0 still does not appear, kill patchram and start it again
#        (the second open succeeds, hci0 in ~8 s).
#  2. mgmt 1.3 lacks LOAD_CONN_PARAM, so the kernel's auto-connect cannot be used.
#     -> even for bonded devices, connect explicitly from user space
set -u

FW=/opt/etc/firmware/BCM43438A1.hcd
PATCHRAM=/opt/bin/brcm_patchram_plus
NAME=${1:-${BT_MOUSE:-}}   # device name: argument, or BT_MOUSE in the environment
if [ -z "$NAME" ]; then
	echo "usage: bt-mouse DEVICE_NAME   (or set BT_MOUSE in the environment)" >&2
	echo "bonded devices:" >&2
	sudo grep -rh --include=info "^Name=" /var/lib/bluetooth/ 2>/dev/null | cut -d= -f2- | sort -u | sed "s/^/  /" >&2
	exit 2
fi

have_hci0() { [ -d /sys/class/bluetooth/hci0 ]; }

wait_hci0() {  # $1 = seconds to wait
	local i
	for ((i = 0; i < $1; i += 2)); do
		sleep 2
		have_hci0 && return 0
	done
	return 1
}

start_patchram() {
	sudo sh -c "setsid $PATCHRAM --patchram $FW --baudrate 1500000 --enable_hci --no2bytes \
		--tosleep 1000 /dev/ttyS0 >/dev/null 2>&1 &"
}

# Open the UART briefly so that CTS is already high when patchram opens it (CTS rises only after the
# host raises RTS by opening the port, and stays high after close; see 1. above).
# It has to be a real open that lasts a moment: stty is too short.
prime_uart() {
	sudo python3 -c "import os, time
fd = os.open('/dev/ttyS0', os.O_RDWR | os.O_NONBLOCK | os.O_NOCTTY)
time.sleep(0.2)
os.close(fd)" 2>/dev/null || true
}

# --- 1. bring up hci0 ---
if have_hci0; then
	echo "hci0: already up"
else
	echo "hci0: powering on..."
	sudo /opt/bin/bt_switch off >/dev/null 2>&1
	sleep 5
	# bt_switch on sleeps 3 s and then starts patchram; that first open of the UART is the one that dies
	# (see 1. above). Prime the port during the wait so CTS is already high by then.
	# Detach stdout/stderr/stdin: the patchram it leaves running would otherwise hold a caller's pipe
	# (or an ssh channel) open, and `ssh dm250 bt-mouse ...` would never return.
	sudo /opt/bin/bt_switch on >/dev/null 2>&1 </dev/null &
	switch_pid=$!
	sleep 1.2
	prime_uart
	wait "$switch_pid" || exit 1

	# first try (hci0 normally appears ~9 s after patchram starts); restart patchram if it does not
	if wait_hci0 30; then
		echo "hci0: up on first try"
	else
		echo "hci0: first try timed out, retrying patchram"
		sudo pkill -f "[b]rcm_patchram" 2>/dev/null
		sleep 2
		start_patchram
		if wait_hci0 40; then
			echo "hci0: up on retry"
		else
			echo "hci0: FAILED -- check /dev/ttyS0 and $FW" >&2
			exit 1
		fi
	fi
fi

# Stopping/starting bluetoothd can leave hci0 DOWN
sudo hciconfig hci0 up 2>/dev/null
systemctl is-active --quiet bluetooth || sudo systemctl start bluetooth
sleep 2
if ! bluetoothctl list 2>/dev/null | grep -q Controller; then
	echo "adapter: re-registering"
	sudo systemctl restart bluetooth
	sleep 5
	sudo hciconfig hci0 up 2>/dev/null
fi

# --- 2. find the bonded device (the address changes with every pairing) ---
# WARNING: do not use a glob: /var/lib/bluetooth is readable only by root, and `*` is expanded by
# the calling shell, so even with sudo it does not match and silently finds nothing
ADDR=$(sudo grep -rl --include=info "^Name=$NAME\$" /var/lib/bluetooth/ 2>/dev/null |
	head -1 | xargs -r dirname | xargs -r basename)
if [ -z "$ADDR" ]; then
	echo "no bonded device named '$NAME'." >&2
	echo "put it in pairing mode and run:  bluetoothctl --agent NoInputNoOutput" >&2
	exit 1
fi
echo "device: $NAME ($ADDR)"

# --- 3. connect. The device can only be caught while it is advertising, so try a few times ---
for t in 1 2 3; do
	if bluetoothctl info "$ADDR" 2>/dev/null | grep -q "Connected: yes"; then
		echo "connected."
		exit 0
	fi
	echo "connect attempt $t (move the mouse to wake it)"
	timeout 25 bluetoothctl connect "$ADDR" >/dev/null 2>&1
	sleep 3
done

if bluetoothctl info "$ADDR" 2>/dev/null | grep -q "Connected: yes"; then
	echo "connected."
else
	echo "not connected -- wake the mouse and run again." >&2
	exit 1
fi
