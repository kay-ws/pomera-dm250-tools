#!/bin/sh
# Print the DM250 battery status on one line.
#
# Remaining time is integrated from a band table of "how many mAh 1% on the fuel gauge represents".
# The scale is neither evenly spaced nor monotonic (30-39% is the finest, 20-29% is
# about twice as coarse). A linear "% x full capacity" calculation is off by roughly 20% in the 20-29% range.
#
# Source: the full-discharge span of 2026-08-24 to 25 in battlog.tsv (100% -> 0%, 222 samples, 18.42h,
# integrated as row order x 300 seconds). Total 5,981mAh / 22.81Wh.
# WARNING: temperature is not shown. The sysfs temp is stuck at 18.8 C in all 559 samples,
#   and does not move while charging or at the end of a full discharge = the sensor is not returning a value.
#
# Kernel 6.18 (power_supply/BATTERY) exposes charge_now, so the remaining charge is read directly and
# the band table is not used. The table describes the 3.10 fuel gauge only (power_supply/battery).
#
# Corrections on 6.18, from two full discharges in battlog.tsv (2026-10-04/05 and 2026-10-06/07,
# 450-540mA load, both ended at 3.21V):
# - The gauge reaches 0 before the battery is empty (15-20 and 35-40 minutes early; the device died at
#   -129..-170mAh and -290..-335mAh). RESERVE adds the smaller of the two, so the estimate stays short.
# - Below 0 the driver reports charge_now as an unsigned value (about 1,797,057mAh minus the deficit)
#   and capacity as 100. Such a value is read back as negative and shown as 0%.
# - Near the end the voltage tracks the time left better than the gauge: both runs agree within one
#   5-minute sample below 3.55V. The table holds only for a load near 500mA.
# - The current is averaged over the discharging samples of the last 35 minutes in battlog.tsv, because a
#   single reading can be far from the typical load (59% once showed 33h).
# For testing, BATT_PSDIR replaces the sysfs root (to exercise the discharging path regardless of the real device state),
# BATT_LOG the log file and BATT_NOW the current epoch.
PSDIR=${BATT_PSDIR:-/sys/class/power_supply}
LOG=${BATT_LOG:-/home/pomera/battlog.tsv}
if [ -e "$PSDIR/BATTERY" ]; then
	P=$PSDIR/BATTERY; AC=$PSDIR/AC; USB=$PSDIR/USB
else
	P=$PSDIR/battery; AC=$PSDIR/ac; USB=$PSDIR/usb
fi

# --short: short form for the herdr sidebar (26 columns by default).
# The band table exists only in this one place, so the short form is also built on the DM250 side.
SHORT=0
[ "${1:-}" = "--short" ] && SHORT=1

[ -r "$P/capacity" ] || { echo "batt: cannot read $P" >&2; exit 1; }

tail -n 8 "$LOG" 2>/dev/null | awk -F'\t' -v cap="$(cat $P/capacity)" \
    -v st="$(cat $P/status)"   \
    -v uv="$(cat $P/voltage_now)" \
    -v ua="$(cat $P/current_now)" \
    -v chg="$(cat $P/charge_now 2>/dev/null)" \
    -v ac="$(cat $AC/online 2>/dev/null || echo 0)" \
    -v usb="$(cat $USB/online 2>/dev/null || echo 0)" \
    -v now="${BATT_NOW:-$(date +%s)}" \
    -v short="$SHORT" '
function fmt(h) { return (h < 1) ? sprintf("%dmin", h*60) : sprintf("%.1fh", h) }
# Discharging samples of the last 35 minutes. A line cut short by a forced power-off is skipped.
NF == 8 && $1 ~ /^[0-9]+$/ && $3 == "Discharging" && $6 < 0 && now - $1 >= 0 && now - $1 <= 2100 {
  sum += -$6/1e3; n++
}
END {
  RESERVE = 130                  # mAh left when the gauge reads 0
  WRAP = 4294967296/2390*1000    # uAh; charge_now below 0 is reported as WRAP minus the deficit

  # mAh per 1% for each band. The index is floor(cap/10); awk arrays start at 1, so look up with +1.
  #        0-9   10-19 20-29 30-39 40-49 50-59 60-69 70-79 80-89 90-99
  split("44.7  77.8  91.1  48.3  50.6  50.4  59.0  55.6  63.7  56.8", mah, " ")

  V = uv/1e6; I = ua/1e3
  A = (I<0 ? -I : I)
  W = A/1000*V
  ja = (st=="Discharging") ? "discharging" : \
       (st=="Charging")    ? "charging" : \
       (st=="Full")        ? "full" : st

  # Sum the charge that flows while the displayed value is c, starting from c=0. 100% is momentary, so cap at 99
  # (otherwise the result is one step too large when fully charged).
  # With charge_now (uAh, kernel 6.18) the gauge reports the remaining charge itself.
  if (chg != "") {
    if (chg > 1e9) { chg -= WRAP; cap = 0 }
    rem = chg/1000 + RESERVE
    if (rem < 0) rem = 0
  } else {
    top = (cap > 99 ? 99 : cap)
    rem = 0
    for (c = 0; c <= top; c++) rem += mah[int(c/10)+1]
  }

  # Time left in hours. Aavg includes the reading taken just now.
  Aavg = (st=="Discharging" && A > 0) ? (sum + A)/(n + 1) : 0
  left = (Aavg > 0) ? rem/Aavg : 0
  if (chg != "" && V < 3.55 && chg/1000 < 300) {
    # Volts -> minutes left, mean of the two runs, interpolated linearly.
    nv = split("3.21 3.34 3.415 3.475 3.51 3.55", tv, " ")
    split("0    5    10    15    20   25",   tm, " ")
    left = 0
    for (i = 1; i < nv; i++)
      if (V >= tv[i]) left = (tm[i] + (tm[i+1]-tm[i]) * (V-tv[i]) / (tv[i+1]-tv[i])) / 60
  }

  if (short) {
    printf "%d%%", cap
    if      (st=="Discharging" && A > 0) printf " %s", fmt(left)
    else if (st=="Charging")             printf " +%s", (ac==1 ? "AC" : usb==1 ? "USB" : "")
    else if (ac==1 || usb==1)            printf " %s",  (ac==1 ? "AC" : "USB")
    printf "\n"
    exit
  }

  printf "%d%%  %s", cap, ja
  if (st=="Discharging" && A > 0)
    printf "  about %s left", fmt(left)
  if (ac==1 || usb==1)
    printf "  [%s power]", (ac==1 ? "AC" : "USB")
  printf "   %.3fV %+.0fmA %.2fW\n", V, I, W
  if (cap <= 20) printf "!! battery low (%d%%)\n", cap
}'
